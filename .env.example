NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecom
MYSQL_USER=ecom_app

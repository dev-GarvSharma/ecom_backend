                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.environment.unset(\"accessToken\");",
                  "  pm.environment.unset(\"userId\");",
                  "}"
                ]
              }
            }
          ]
        }
